generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Float
  description String
  image       String
  category    String
  isAvailable Boolean  @default(true)
}

model Category {
  id   String @id @default(cuid())
  name String @unique
}

model Order {
  id            String   @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String?
  facebookName  String?
  facebookUrl   String?
  address       String?
  deliveryFee   Int      @default(0)
  items         String   // Storing as JSON string
  totalAmount   Float
  paymentMethod String
  proofOfPayment String?
  status        String   @default("Pending")
  createdAt     DateTime @default(now())
}

model SiteSetting {
  id               String @id @default("global")
  deliveryTaguig   Int    @default(50)
  deliveryMakati   Int    @default(70)
  aboutDescription String @default("Affordable pixel art accessories for students. Keychains, DIY bracelets, and more.")
  aboutDevs        String @default("QuadCore_023 is a dedicated development group behind PixelFuse PH.")
  facebookUrl      String @default("https://web.facebook.com/profile.php?id=61590007025954")
}
